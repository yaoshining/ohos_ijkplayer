+#define P30_OWNER(hw, op_, rc_) do { \
+    struct ohcodec_priv *p30p = (hw)->priv; \
+    MP_INFO(hw, "P30_OWNER seq=%"PRIu64" t=%"PRId64" pid=%ld tid=%ld op=%s owner=%"PRIu64" generation=1 consumer=%"PRIu64" rc=%d\n", \
