+/* Reserve by consumer identity before SetSurface. Two wrappers can refer to
+ * the same consumer. A failed Destroy leaves its reservation in this list. */
+static AVMutex surface_mutex = AV_MUTEX_INITIALIZER;
+static OHCodecDecRef *surface_owners;
+
+static int oh_decode_claim_surface(OHCodecDecRef *ref, OHNativeWindow *window)
+{
+    uint64_t id;
+    if (OH_NativeWindow_GetSurfaceId(window, &id) || !id ||
+        OH_NativeWindow_NativeObjectReference(window))
+        return AVERROR_EXTERNAL;
+
+    ff_mutex_lock(&surface_mutex);
+    for (OHCodecDecRef *owner = surface_owners; owner; owner = owner->next_surface) {
+        if (owner->surface_id == id) {
+            ff_mutex_unlock(&surface_mutex);
+            OH_NativeWindow_NativeObjectUnreference(window);
+            return AVERROR(EBUSY);
+        }
+    }
+    ref->window = window;
+    ref->surface_id = id;
+    ref->next_surface = surface_owners;
+    surface_owners = ref;
+    ff_mutex_unlock(&surface_mutex);
+    return 0;
+}
+
+static void oh_decode_release_surface(OHCodecDecRef *ref)
+{
+    if (!ref->window)
+        return;
+    ff_mutex_lock(&surface_mutex);
+    OHCodecDecRef **link = &surface_owners;
+    while (*link != ref)
+        link = &(*link)->next_surface;
+    *link = ref->next_surface;
+    ref->next_surface = NULL;
+    ff_mutex_unlock(&surface_mutex);
+    OH_NativeWindow_NativeObjectUnreference(ref->window);
+    ref->window = NULL;
+}
