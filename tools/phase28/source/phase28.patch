+static void oh_decode_end(OHCodecDecRef *ref)
+{
+    if (!ref || !ref->gate_initialized)
+        return;
+    ff_mutex_lock(&ref->gate);
+    if (ref->active > 0)
+        ref->active--;
+    ff_cond_broadcast(&ref->gate_cond);
+    ff_mutex_unlock(&ref->gate);
