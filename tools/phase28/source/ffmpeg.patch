+#include "ohcodec_hdr.h"
+#include "hevc/hevc.h"
+#include "libavutil/error.h"
+
+/* 只拆SEI envelope；payload和AVFrame转换复用FFmpeg真实实现。 */
+static int parse_static_sei(H2645SEI *sei, AVCodecContext *ctx,
+                            const H2645NAL *nal)
+{
+    const uint8_t *p = nal->data + 2, *end = nal->data + nal->size;
+    while (p < end) {
+        if (*p == 0x80) {
+            const uint8_t *q = p + 1;
+            while (q < end && !*q) q++;
+            if (q == end) return 0;
+        }
+        unsigned type = 0, size = 0, byte;
+        do {
+            if (p == end || type > INT_MAX - 255) return AVERROR_INVALIDDATA;
+            byte = *p++; type += byte;
+        } while (byte == 255);
+        do {
+            if (p == end || size > INT_MAX - 255) return AVERROR_INVALIDDATA;
+            byte = *p++; size += byte;
+        } while (byte == 255);
+        if (size > end - p) return AVERROR_INVALIDDATA;
+        if (type == SEI_TYPE_MASTERING_DISPLAY_COLOUR_VOLUME ||
+            type == SEI_TYPE_CONTENT_LIGHT_LEVEL_INFO) {
+            GetByteContext gb;
+            GetBitContext bits;
+            int ret;
+            bytestream2_init(&gb, p, size);
+            ret = init_get_bits8(&bits, p, size);
+            if (ret < 0) return ret;
+            ret = ff_h2645_sei_message_decode(sei, type, AV_CODEC_ID_HEVC,
+                                               &bits, &gb, ctx);
+            if (ret < 0) return ret;
+        }
+        p += size;
+    }
+    return 0;
+}
+
+int ff_oh_hdr_prepare(OHHdrState *s, AVCodecContext *ctx,
+                      const uint8_t *data, int size, int64_t pts,
+                      uint64_t generation)
+{
+    OHHdrPending pending = {0};
+    H2645SEI sei = {0};
+    int ret, last_eos = s->eos, eos_at_start = 1;
+    if (ctx->codec_id != AV_CODEC_ID_HEVC || !size || s->disabled) return 0;
+    if (s->pending.prepared) return 0; /* 同一packet等待/分片，不重复解析。 */
+    ret = ff_h2645_packet_split(&s->packet, data, size, ctx, 0,
+                                 AV_CODEC_ID_HEVC, H2645_FLAG_SMALL_PADDING);
+    if (ret < 0) return ret;
+    sei.mastering_display = s->current.mastering_display;
+    sei.content_light = s->current.content_light;
+    pending.entry.pts = pts;
+    pending.entry.generation = generation;
+    pending.entry.ambiguous = pts == AV_NOPTS_VALUE;
+    // 平台可能改写未知PTS；不能让它与真实0或其他帧误配。
+    pending.disable = pts == AV_NOPTS_VALUE;
+    /* 和软件HEVC一致，packet开头EOS作用于本帧，后面的作用于下一packet。 */
+    for (int i = 0; i < s->packet.nb_nals; i++) {
+        H2645NAL *nal = &s->packet.nals[i];
+        if (nal->nuh_layer_id) continue;
+        if (nal->type == HEVC_NAL_EOS_NUT || nal->type == HEVC_NAL_EOB_NUT) {
+            if (eos_at_start) last_eos = 1;
+            else pending.eos = 1;
+        } else eos_at_start = 0;
+    }
+    for (int i = 0; i < s->packet.nb_nals; i++) {
+        H2645NAL *nal = &s->packet.nals[i];
+        if (nal->nuh_layer_id) continue;
+        if (nal->type == HEVC_NAL_SEI_PREFIX) {
+            ret = parse_static_sei(&sei, ctx, nal);
+            if (ret < 0) return ret;
+        } else if (nal->type <= 31) {
+            int first;
+            if (nal->size < 3) return AVERROR_INVALIDDATA;
+            first = !!(nal->data[2] & 0x80);
+            if ((pending.picture && first) || (!pending.picture && !first))
+                pending.disable = 1;
+            if (pending.picture) continue;
+            pending.picture = 1;
+            if ((nal->type >= HEVC_NAL_BLA_W_LP && nal->type <= HEVC_NAL_IDR_N_LP) ||
+                (nal->type == HEVC_NAL_CRA_NUT && last_eos)) {
+                if (sei.mastering_display.present) sei.mastering_display.present--;
+                if (sei.content_light.present) sei.content_light.present--;
+            }
+            pending.entry.metadata.mastering_display = sei.mastering_display;
+            pending.entry.metadata.content_light = sei.content_light;
+        }
+    }
+    if (pending.picture && !pending.disable && s->count == OH_HDR_QUEUE_SIZE)
+        return AVERROR(ENOMEM); /* 不淘汰仍可能在重排中的旧帧。 */
+    pending.next.mastering_display = sei.mastering_display;
+    pending.next.content_light = sei.content_light;
+    pending.prepared = 1;
+    s->pending = pending;
+    if (pending.disable)
+        av_log(ctx, AV_LOG_WARNING, "OHCodec HDR: unknown PTS or ambiguous access-unit layout; static metadata disabled until flush\n");
+    return 0;
+}
+
+void ff_oh_hdr_commit(OHHdrState *s)
+{
+    OHHdrPending *p = &s->pending;
+    if (!p->prepared || p->committed) return;
+    p->committed = 1;
+    s->current = p->next;
+    s->eos = p->eos;
+    if (p->disable) {
+        s->disabled = 1;
+        s->count = 0;
+        return;
+    }
+    if (!p->picture) return;
+    for (unsigned i = 0; i < s->count; i++) {
+        OHHdrEntry *e = &s->entries[i];
+        if (e->generation == p->entry.generation && e->pts == p->entry.pts)
+            e->ambiguous = p->entry.ambiguous = 1;
+    }
+    s->entries[s->count++] = p->entry;
+}
+
+void ff_oh_hdr_finish(OHHdrState *s)
+{
+    s->pending = (OHHdrPending){0};
+}
+
+int ff_oh_hdr_attach(OHHdrState *s, AVCodecContext *ctx, AVFrame *frame,
+                     uint64_t generation, int64_t pts)
+{
+    H2645SEI sei = {0};
+    H2645VUI vui = {0};
+    unsigned index;
+    int ret = 0;
+    if (s->disabled || ctx->codec_id != AV_CODEC_ID_HEVC) return 0;
+    for (index = 0; index < s->count; index++)
+        if (s->entries[index].generation == generation && s->entries[index].pts == pts)
+            break;
+    if (index == s->count) {
+        av_log(ctx, AV_LOG_DEBUG, "OHCodec HDR: no committed metadata snapshot for output PTS\n");
+        return 0;
+    }
+    OHHdrEntry *e = &s->entries[index];
+    if (e->ambiguous) {
+        av_log(ctx, AV_LOG_WARNING, "OHCodec HDR: ambiguous or unknown output PTS; static metadata omitted\n");
+    } else {
+        /* 由上游转换器应用默认码流优先或显式 side_data_prefer_packet。 */
+        sei.mastering_display = e->metadata.mastering_display;
+        sei.content_light = e->metadata.content_light;
+        ret = ff_h2645_sei_to_frame(frame, &sei, AV_CODEC_ID_HEVC, ctx,
+                                     &vui, 0, 0, 0);
+        if (ret < 0) return ret;
+    }
+    memmove(e, e + 1, (s->count - index - 1) * sizeof(*e));
+    s->count--;
+    return 0;
+}
+
+void ff_oh_hdr_reset(OHHdrState *s)
+{
+    ff_h2645_packet_uninit(&s->packet);
+    memset(s, 0, sizeof(*s));
+}
+
+void ff_oh_hdr_uninit(OHHdrState *s)
+{
+    ff_oh_hdr_reset(s);
+}
