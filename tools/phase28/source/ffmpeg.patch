+/* OHCodec 静态HDR：仅decode线程使用，平台回调不访问这些状态。 */
+#ifndef AVCODEC_OHCODEC_HDR_H
+#define AVCODEC_OHCODEC_HDR_H
+#include "avcodec.h"
+#include "h2645_parse.h"
+#include "h2645_sei.h"
+#define OH_HDR_QUEUE_SIZE 256
+
+typedef struct OHHdrMetadata {
+    H2645SEIMasteringDisplay mastering_display;
+    H2645SEIContentLight content_light;
+} OHHdrMetadata;
+typedef struct OHHdrEntry {
+    uint64_t generation;
+    int64_t pts;
+    int ambiguous;
+    OHHdrMetadata metadata;
+} OHHdrEntry;
+typedef struct OHHdrPending {
+    int prepared, committed, picture, disable, eos;
+    OHHdrEntry entry;
+    OHHdrMetadata next;
+} OHHdrPending;
+typedef struct OHHdrState {
+    OHHdrMetadata current;
+    OHHdrPending pending;
+    OHHdrEntry entries[OH_HDR_QUEUE_SIZE];
+    unsigned count;
+    int eos, disabled;
+    H2645Packet packet;
+} OHHdrState;
+int ff_oh_hdr_prepare(OHHdrState *s, AVCodecContext *ctx,
+                      const uint8_t *data, int size, int64_t pts,
+                      uint64_t generation);
+void ff_oh_hdr_commit(OHHdrState *s);
+void ff_oh_hdr_finish(OHHdrState *s);
+int ff_oh_hdr_attach(OHHdrState *s, AVCodecContext *ctx, AVFrame *frame,
+                     uint64_t generation, int64_t pts);
+void ff_oh_hdr_reset(OHHdrState *s);
+void ff_oh_hdr_uninit(OHHdrState *s);
+#endif
